# Chép thành .env.local rồi điền giá trị (Firebase Console → Project settings → Your apps → Web app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
# Site key reCAPTCHA v3 cho App Check.
VITE_RECAPTCHA_SITE_KEY=
# Chỉ dùng khi dev: debug token đã đăng ký ở Firebase Console → App Check → Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
